+//! Nonblocking MPEG audio packetization over caller-owned contiguous input.
+//! The caller retains an incomplete prefix, skips the returned byte count and
+//! supplies more input. No blocking source adapter or per-packet allocation is
+//! required. MPEG and Xing/LAME parsing are shared with the normal demuxer.
+use symphonia_core::errors::{Error, Result, decode_error, unsupported_error};
+use symphonia_core::formats::Track;
+use symphonia_core::io::{BufReader, ReadBytes};
+use symphonia_core::packet::{PacketBuilder, PacketRef};
+use symphonia_core::units::{Duration, Timestamp};
+use symphonia_metadata::id3v2::Id3v2Reader;
+
+use crate::common::{FrameHeader, MpegLayer, MpegVersion};
+use crate::{demuxer, header};
+
+/// One incremental step. `NeedMore` never consumes input or changes timing.
+#[derive(Debug)]
+pub enum PacketStep<'a> {
+    NeedMore,
+    Discard(usize),
+    Packet { consumed: usize, packet: PacketRef<'a> },
+    End,
+}
+
+/// Bounded metadata/junk policy. These limits do not limit audio track length.
+#[derive(Clone, Copy, Debug)]
+pub struct PacketizerOptions {
+    pub max_metadata_bytes: u64,
+    pub max_junk_bytes: u64,
+}
+
+impl Default for PacketizerOptions {
+    fn default() -> Self {
+        Self { max_metadata_bytes: 64 * 1024, max_junk_bytes: 64 * 1024 }
+    }
+}
+
+/// A push packetizer. Errors are terminal; recreate it for a different stream.
+pub struct MpaPacketizer {
+    options: PacketizerOptions,
+    metadata_bytes: u64,
+    junk_bytes: u64,
+    tag_remaining: u64,
+    signature: Option<(MpegVersion, MpegLayer, u32, usize)>,
+    track: Option<Track>,
+    next_pts: Timestamp,
+    remaining_packets: Option<u64>,
+    failed: bool,
+    finished: bool,
+}
+
+impl MpaPacketizer {
+    pub fn new(options: PacketizerOptions) -> Self {
+        Self {
+            options,
+            metadata_bytes: 0,
+            junk_bytes: 0,
+            tag_remaining: 0,
+            signature: None,
+            track: None,
+            next_pts: Timestamp::ZERO,
+            remaining_packets: None,
+            failed: false,
+            finished: false,
+        }
+    }
+
+    pub fn track(&self) -> Option<&Track> {
+        self.track.as_ref()
+    }
+
+    pub fn next<'a>(&mut self, input: &'a [u8], eof: bool) -> Result<PacketStep<'a>> {
+        if self.failed {
+            return decode_error("mpa: packetizer previously failed");
+        }
+        let result = self.next_inner(input, eof);
+        if result.is_err() {
+            self.failed = true;
+        }
+        result
+    }
+
+    fn begin_tag(&mut self, len: u64, input: &[u8], eof: bool) -> Result<PacketStep<'static>> {
+        self.metadata_bytes = self
+            .metadata_bytes
+            .checked_add(len)
+            .filter(|total| *total <= self.options.max_metadata_bytes)
+            .ok_or(Error::DecodeError("mpa: metadata byte budget exceeded"))?;
+        self.tag_remaining = len;
+        self.skip_tag(input, eof)
+    }
+
+    fn skip_tag(&mut self, input: &[u8], eof: bool) -> Result<PacketStep<'static>> {
+        if eof && (input.len() as u64) < self.tag_remaining {
+            return decode_error("mpa: truncated metadata tag");
+        }
+        let consumed = self.tag_remaining.min(input.len() as u64) as usize;
+        self.tag_remaining -= consumed as u64;
+        Ok(PacketStep::Discard(consumed))
+    }
+
+    fn next_inner<'a>(&mut self, input: &'a [u8], eof: bool) -> Result<PacketStep<'a>> {
+        if self.finished {
+            return if input.is_empty() && eof {
+                Ok(PacketStep::End)
+            } else {
+                decode_error("mpa: input after end of stream")
+            };
+        }
+        if input.is_empty() {
+            if !eof {
+                return Ok(PacketStep::NeedMore);
+            }
+            if self.tag_remaining != 0 || self.remaining_packets.is_some_and(|count| count != 0) {
+                return decode_error("mpa: stream ended before its declared data");
+            }
+            self.finished = true;
+            return Ok(PacketStep::End);
+        }
+        if self.tag_remaining != 0 {
+            return self.skip_tag(input, eof);
+        }
+        if input.starts_with(b"ID3") {
+            if input.len() < 10 {
+                return if eof {
+                    decode_error("mpa: truncated ID3 header")
+                } else {
+                    Ok(PacketStep::NeedMore)
+                };
+            }
+            let len = Id3v2Reader::total_tag_len(input[..10].try_into().expect("length checked"))?;
+            return self.begin_tag(u64::from(len), input, eof);
+        }
+        // ID3v1 has one fixed 128-byte extent and no variable length fields.
+        // Only classify it at a packet boundary, never inside an encoded frame.
+        if input.starts_with(b"TAG") {
+            return self.begin_tag(128, input, eof);
+        }
+        if input.len() < header::MPEG_HEADER_LEN {
+            if !eof {
+                return Ok(PacketStep::NeedMore);
+            }
+            if input[0] == 0xff {
+                return decode_error("mpa: truncated MPEG header");
+            }
+            return self.discard_junk(input.len());
+        }
+        let word = BufReader::new(input).read_be_u32()?;
+        if !header::is_frame_header_word_synced(word) || !header::check_header(word) {
+            if self.signature.is_some() {
+                return decode_error("mpa: lost frame synchronization");
+            }
+            return self.discard_junk(1);
+        }
+        let frame = header::parse_frame_header(word)?;
+        let size = header::MPEG_HEADER_LEN + frame.frame_size;
+        if size > header::MAX_MPEG_FRAME_SIZE {
+            return decode_error("mpa: invalid MPEG frame size");
+        }
+        if input.len() < size {
+            return if eof {
+                decode_error("mpa: truncated MPEG frame")
+            } else {
+                Ok(PacketStep::NeedMore)
+            };
+        }
+        let signature = (frame.version, frame.layer, frame.sample_rate, frame.n_channels());
+        if let Some(previous) = self.signature {
+            if signature != previous {
+                return unsupported_error("mpa: changing stream format is not supported");
+            }
+        } else {
+            // Confirm the initial sync without decoding/rejecting a frame over
+            // the real decoder's bit reservoir. A complete lone EOF frame is
+            // allowed, as is a frame followed by a recognized metadata tag.
+            if !eof {
+                if input.len() < size + 4 {
+                    return Ok(PacketStep::NeedMore);
+                }
+                let next = &input[size..];
+                if !next.starts_with(b"ID3") && !next.starts_with(b"TAG") {
+                    let next_word = BufReader::new(next).read_be_u32()?;
+                    if !header::is_frame_header_word_synced(next_word) {
+                        return self.discard_junk(1);
+                    }
+                    match header::parse_frame_header(next_word) {
+                        Ok(next)
+                            if (next.version, next.layer, next.sample_rate, next.n_channels())
+                                == signature =>
+                        {
+                            ()
+                        }
+                        _ => return self.discard_junk(1),
+                    }
+                }
+            }
+            let (track, is_info) = demuxer::first_frame_track(&frame, &input[..size]);
+            if track.num_frames.is_none() && track.padding.is_some_and(|padding| padding != 0) {
+                return unsupported_error("mpa: padding without a declared frame count");
+            }
+            if let Some(valid) = track.num_frames {
+                let decoded = valid
+                    .checked_add(u64::from(track.delay.unwrap_or(0)))
+                    .and_then(|count| count.checked_add(u64::from(track.padding.unwrap_or(0))))
+                    .ok_or(Error::DecodeError("mpa: declared frame count overflow"))?;
+                if decoded % u64::from(frame.num_frames()) != 0 {
+                    return decode_error("mpa: inconsistent gapless frame count");
+                }
+                self.remaining_packets = Some(decoded / u64::from(frame.num_frames()));
+            }
+            self.next_pts = Timestamp::new(-i64::from(track.delay.unwrap_or(0)));
+            self.track = Some(track);
+            self.signature = Some(signature);
+            if is_info {
+                return Ok(PacketStep::Discard(size));
+            }
+        }
+        if demuxer::try_read_info_tag(&input[..size], &frame).is_some()
+            || demuxer::try_read_vbri_tag(&input[..size], &frame).is_some()
+        {
+            return decode_error("mpa: unexpected midstream duration tag");
+        }
+        if let Some(remaining) = self.remaining_packets.as_mut() {
+            *remaining = remaining
+                .checked_sub(1)
+                .ok_or(Error::DecodeError("mpa: audio exceeds its declared frame count"))?;
+        }
+        let track = self.track.as_ref().expect("initialized with signature");
+        let packet = PacketBuilder::new()
+            .track_id(0)
+            .pts(self.next_pts)
+            .trimmed_dur(
+                frame.duration(),
+                track
+                    .num_frames
+                    .and_then(|frames| Duration::new(frames).timestamp_from(Timestamp::ZERO)),
+            )
+            .data_by_ref(&input[..size])
+            .build_packet_ref();
+        self.next_pts = self
+            .next_pts
+            .checked_add(frame.duration())
+            .ok_or(Error::DecodeError("mpa: stream timestamp overflow"))?;
+        Ok(PacketStep::Packet { consumed: size, packet })
+    }
+
+    fn discard_junk(&mut self, bytes: usize) -> Result<PacketStep<'static>> {
+        self.junk_bytes = self
+            .junk_bytes
+            .checked_add(bytes as u64)
+            .filter(|total| *total <= self.options.max_junk_bytes)
+            .ok_or(Error::DecodeError("mpa: synchronization byte budget exceeded"))?;
+        Ok(PacketStep::Discard(bytes))
+    }
+}
