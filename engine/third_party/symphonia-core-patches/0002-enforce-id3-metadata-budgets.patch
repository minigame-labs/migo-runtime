+impl Tag {
+    /// Includes the inline Tag, owned capacities and Arc payloads. The raw and
+    /// standard value's identical String Arc is charged once; other shared
+    /// allocations may be conservatively charged repeatedly.
+    pub fn storage_size_upper_bound(&self) -> usize {
+        let mut size = std::mem::size_of::<Self>()
+            .saturating_add(self.raw.key.capacity())
+            .saturating_add(self.raw.value.heap_size_upper_bound());
+        if let Some(fields) = &self.raw.sub_fields {
+            size = size.saturating_add(fields.len() * std::mem::size_of::<RawTagSubField>());
+            for field in fields.iter() {
+                size = size
+                    .saturating_add(field.field.capacity())
+                    .saturating_add(field.value.heap_size_upper_bound());
+            }
+        }
+        if let Some(value) = &self.std {
+            size = size.saturating_add(value.heap_size_upper_bound(&self.raw.value));
+        }
+        size
+    }
+}
