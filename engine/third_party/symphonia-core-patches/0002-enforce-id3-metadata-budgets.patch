+impl RawValue {
+    /// Conservative heap storage reachable through this value. Scalar storage
+    /// is inline in Tag; allocator overhead is not represented here.
+    pub fn heap_size_upper_bound(&self) -> usize {
+        let arc = 2 * std::mem::size_of::<usize>();
+        match self {
+            Self::Binary(bytes) => arc + std::mem::size_of::<Box<[u8]>>() + bytes.len(),
+            Self::String(value) => arc + std::mem::size_of::<String>() + value.capacity(),
+            Self::StringList(values) => values.iter().fold(
+                arc + std::mem::size_of::<Vec<String>>()
+                    + values.capacity() * std::mem::size_of::<String>(),
+                |size, value| size.saturating_add(value.capacity()),
+            ),
+            Self::Boolean(_)
+            | Self::Flag
+            | Self::Float(_)
+            | Self::SignedInt(_)
+            | Self::UnsignedInt(_) => 0,
+        }
+    }
+}
