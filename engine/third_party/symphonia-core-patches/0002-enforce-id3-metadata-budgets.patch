+impl Visual {
+    /// Includes owned data and tag vector capacity, excluding allocator overhead.
+    pub fn storage_size_upper_bound(&self) -> usize {
+        self.tags.iter().fold(
+            std::mem::size_of::<Self>()
+                + self.data.len()
+                + self.media_type.as_ref().map_or(0, String::capacity)
+                + self.tags.capacity() * std::mem::size_of::<Tag>(),
+            |size, tag| {
+                size.saturating_add(
+                    tag.storage_size_upper_bound()
+                        .saturating_sub(std::mem::size_of::<Tag>()),
+                )
+            },
+        )
+    }
