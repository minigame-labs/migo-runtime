+/// A recognized container whose reader has not been constructed yet.
+/// Identification uses the same registry, scoring and leading metadata path as
+/// `Probe::probe`. It does not parse a container index or trailing metadata.
+/// Call `into_reader` to resume with the captured stream and metadata policy.
+pub struct ProbedFormat<'s> {
+    info: FormatInfo,
+    factory: FormatFactoryFn,
+    source: MediaSourceStream<'s>,
+    options: FormatOptions,
+}
+impl<'s> ProbedFormat<'s> {
+    pub fn info(&self) -> FormatInfo {
+        self.info
+    }
+    pub fn into_reader(self) -> Result<Box<dyn FormatReader + 's>> {
+        (self.factory)(self.source, self.options)
+    }
+}
 
