+#[cfg(test)]
+mod identification_tests {
+    use super::*;
+    use crate::{
+        common::{FourCc, Limit},
+        formats::FormatId,
+        io::ReadOnlySource,
+    };
+    use std::{
+        cell::Cell,
+        io::{self, Cursor, Read, Seek, SeekFrom},
+    };
+    thread_local! { static CONSTRUCTIONS: Cell<usize> = const {Cell::new(0)}; }
+    fn info() -> FormatInfo {
+        FormatInfo {
+            format: FormatId::new(FourCc::new(*b"TEST")),
+            short_name: "test",
+            long_name: "test",
+        }
+    }
+    fn construct<'a>(
+        _: MediaSourceStream<'a>,
+        options: FormatOptions,
+    ) -> Result<Box<dyn FormatReader + 'a>> {
+        CONSTRUCTIONS.with(|n| n.set(n.get() + 1));
+        assert!(matches!(
+            options.metadata_options.limit_total_bytes,
+            Limit::Maximum(0)
+        ));
+        crate::errors::unsupported_error("factory observed")
+    }
+    fn score(_: ScopedStream<&mut MediaSourceStream<'_>>) -> Result<Score> {
+        Ok(Score::Supported(255))
+    }
+    fn probe() -> Probe {
+        let mut p = Probe::new();
+        p.register(
+            Tier::Standard,
+            GenericProbeMatch {
+                spec: ProbeDataMatchSpec {
+                    extensions: &[],
+                    mime_types: &[],
+                    markers: &[b"TEST"],
+                },
+                score,
+                specific: ProbeMatch::Format {
+                    info: info(),
+                    factory: construct,
+                },
+                anchors: Anchors::None,
+            },
+        );
+        p
+    }
+    fn metadata() -> MetadataOptions {
+        MetadataOptions::default().limit_total_bytes(Limit::Maximum(0))
+    }
+    fn stream() -> MediaSourceStream<'static> {
+        MediaSourceStream::new(
+            Box::new(ReadOnlySource::new(Cursor::new(b"TEST payload"))),
+            Default::default(),
+        )
+    }
+    #[test]
+    fn identify_defers_factory_and_into_reader_preserves_policy() {
+        CONSTRUCTIONS.with(|n| n.set(0));
+        let p = probe();
+        let identified = p.probe_format(&Hint::new(), stream(), metadata()).unwrap();
+        assert_eq!(identified.info().format, info().format);
+        assert_eq!(CONSTRUCTIONS.with(Cell::get), 0);
+        assert!(identified.into_reader().is_err());
+        assert_eq!(CONSTRUCTIONS.with(Cell::get), 1);
+    }
+    #[test]
+    fn full_probe_still_constructs_through_the_shared_search() {
+        CONSTRUCTIONS.with(|n| n.set(0));
+        assert!(probe()
+            .probe(&Hint::new(), stream(), FormatOptions::default(), metadata())
+            .is_err());
+        assert_eq!(CONSTRUCTIONS.with(Cell::get), 1);
+    }
+    struct NoSeek(Cursor<&'static [u8]>);
+    impl Read for NoSeek {
+        fn read(&mut self, b: &mut [u8]) -> io::Result<usize> {
+            self.0.read(b)
+        }
+    }
+    impl Seek for NoSeek {
+        fn seek(&mut self, _: SeekFrom) -> io::Result<u64> {
+            panic!("identification sought trailing metadata")
+        }
+    }
+    impl MediaSource for NoSeek {
+        fn is_seekable(&self) -> bool {
+            true
+        }
+        fn byte_len(&self) -> Option<u64> {
+            Some(self.0.get_ref().len() as u64)
+        }
+    }
+    #[test]
+    fn identification_never_probes_the_tail_of_a_seekable_source() {
+        let source = MediaSourceStream::new(
+            Box::new(NoSeek(Cursor::new(b"TEST payload"))),
+            Default::default(),
+        );
+        assert!(probe()
+            .probe_format(&Hint::new(), source, metadata())
+            .is_ok());
+    }
+}
