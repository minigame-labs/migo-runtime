+impl SeekBuffered for BufReader<'_> {
+    fn ensure_seekback_buffer(&mut self, _len: usize) {
+        // The entire borrowed slice is already buffered for this reader's lifetime.
+    }
+
+    fn unread_buffer_len(&self) -> usize {
+        self.buf.len() - self.pos
+    }
+
+    fn read_buffer_len(&self) -> usize {
+        self.pos
+    }
+
+    fn seek_buffered(&mut self, pos: u64) -> u64 {
+        self.pos = pos.min(self.buf.len() as u64) as usize;
+        self.pos as u64
+    }
+
+    fn seek_buffered_rel(&mut self, delta: isize) -> u64 {
+        self.pos = self.pos.saturating_add_signed(delta).min(self.buf.len());
+        self.pos as u64
     }
