+    #[test]
+    fn verify_slice_seek_is_clamped_and_preserves_real_positions() {
+        let bytes: Vec<u8> = (0..32).collect();
+        for len in 0..=bytes.len() {
+            for pos in 0..=len + 1 {
+                let mut reader = BufReader::new(&bytes[..len]);
+                reader.ensure_seekback_buffer(usize::MAX);
+                assert_eq!(reader.seek_buffered(pos as u64), pos.min(len) as u64);
+                assert_eq!(reader.read_buffer_len(), pos.min(len));
+                assert_eq!(reader.unread_buffer_len(), len - pos.min(len));
+                for delta in [isize::MIN, -33, -1, 0, 1, 33, isize::MAX] {
+                    reader.seek_buffered(pos as u64);
+                    let expected = ((pos.min(len) as i128) + delta as i128).clamp(0, len as i128) as u64;
+                    assert_eq!(reader.seek_buffered_rel(delta), expected);
+                    assert_eq!(reader.pos(), expected);
+                    if expected < len as u64 {
+                        assert_eq!(reader.read_byte().unwrap(), bytes[expected as usize]);
+                    }
+                }
+                assert_eq!(reader.seek_buffered(u64::MAX), len as u64);
+            }
+        }
+    }
