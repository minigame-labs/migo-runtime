Pin the bindgen fix for Clang 22 and newer declaration/definition cursors.

With 0.72.0 and libclang 23, v8::String::WriteFlags is emitted as WriteFlags,
so the generated FFI binding fails to compile at both string flags. 0.72.1's
clang.rs resolves the definition cursor and restores the qualified names.

--- a/Cargo.lock
+++ b/Cargo.lock
@@ -82,8 +82,8 @@
 [[package]]
 name = "bindgen"
-version = "0.72.0"
+version = "0.72.1"
 source = "registry+https://github.com/rust-lang/crates.io-index"
-checksum = "4f72209734318d0b619a5e0f5129918b848c416e122a3c4ce054e03cb87b726f"
+checksum = "993776b509cfb49c750f11b8f07a46fa23e0a1386ffc01fb1e7d343efc387895"
 dependencies = [
  "bitflags 2.9.3",
