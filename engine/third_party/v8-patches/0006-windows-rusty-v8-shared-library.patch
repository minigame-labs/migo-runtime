--- a/BUILD.gn
+++ b/BUILD.gn
@@ -5,8 +5,16 @@
   rusty_v8_enable_simdutf = false
 }
 
-static_library("rusty_v8") {
-  complete_static_lib = true
+# MIGO: Windows isolates V8's bundled C++ runtime inside the DLL.
+# Preserve the entire upstream binding graph, including crdtp and simdutf.
+_rusty_v8_library_type = "static_library"
+if (is_win) {
+  _rusty_v8_library_type = "shared_library"
+}
+target(_rusty_v8_library_type, "rusty_v8") {
+  if (!is_win) {
+    complete_static_lib = true
+  }
   sources = [
     "src/binding.cc",
     "src/crdtp_binding.cc",
@@ -27,6 +35,10 @@
     "//build/config/compiler:thin_archive",
   ]
   configs += [ ":rusty_v8_config" ]
+  if (is_win) {
+    inputs = [ "rusty_v8.def" ]
+    ldflags = [ "/DEF:" + rebase_path("rusty_v8.def", root_build_dir) ]
+  }
 }
 
 config("rusty_v8_config") {
