+      platform::v8__Platform__CustomPlatform__BASE__PostNonNestableTask,
+      platform::v8__Platform__CustomPlatform__BASE__PostDelayedTask,
+      platform::v8__Platform__CustomPlatform__BASE__PostNonNestableDelayedTask,
