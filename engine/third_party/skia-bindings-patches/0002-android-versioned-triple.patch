+/// The triple clang compiles for, carrying the API level: clang derives `__ANDROID_API__` from
+/// it, and the NDK's headers refuse a triple without one ("Unversioned target triples are not
+/// supported!"). It names the CPU the way the NDK does, which for 32-bit ARM is not Cargo's way.
+fn clang_target(target: &Target) -> String {
+    let triple = match target.architecture.as_str() {
+        "arm" | "armv7" | "thumbv7neon" => "armv7a-linux-androideabi".to_string(),
+        _ => target.to_string(),
+    };
+    format!("{triple}{API_LEVEL}")
 }
 
