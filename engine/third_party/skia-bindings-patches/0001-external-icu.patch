 /// Returns a 20 digit hash of the repository located in the current directory.
 pub fn half_hash() -> Option<String> {
+    // A packaged crate unpacked into the registry is in no repository, so this always answered
+    // `None` there. Vendored into another project's repository it would answer that project's
+    // HEAD; keep the registry's answer so export and forced-download keys do not change.
+    if crate::build_support::cargo::is_crate() {
+        return None;
+    }
     let mut cmd = Command::new("git");
     cmd.arg("rev-parse").arg("--short=20");
     let output = cmd.arg("HEAD").stderr(Stdio::inherit()).output().ok()?;
