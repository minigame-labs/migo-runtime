+#[test]
+fn extensible_zero_valid_bits_and_unpositioned_32_channels_keep_their_width() {
+    let mut bytes = Vec::new();
+    bytes.extend_from_slice(&0xfffe_u16.to_le_bytes());
+    bytes.extend_from_slice(&32_u16.to_le_bytes());
+    bytes.extend_from_slice(&48000_u32.to_le_bytes());
+    bytes.extend_from_slice(&(48000_u32 * 128).to_le_bytes());
+    bytes.extend_from_slice(&128_u16.to_le_bytes());
+    bytes.extend_from_slice(&32_u16.to_le_bytes());
+    bytes.extend_from_slice(&22_u16.to_le_bytes());
+    bytes.extend_from_slice(&0_u16.to_le_bytes());
+    bytes.extend_from_slice(&0_u32.to_le_bytes());
+    bytes.extend_from_slice(&[1, 0, 0, 0, 0, 0, 0x10, 0, 0x80, 0, 0, 0xaa, 0, 0x38, 0x9b, 0x71]);
+    let format = WaveFormatChunk::parse(&mut symphonia_core::io::BufReader::new(&bytes), *b"fmt ", 40).unwrap();
+    let FormatData::Extensible(ext) = format.format_data else { panic!("extensible format") };
+    assert_eq!(ext.valid_bits_per_sample, 32);
+    assert_eq!(ext.channels, Channels::Discrete(32));
+    assert_eq!(ext.make_packet_info().unwrap().block_size.get(), 128);
+    assert!(WaveFormatChunk::read_pcm_fmt(&mut symphonia_core::io::BufReader::new(&[]), 4, 16, 1, 16).is_err());
+}
