+#[test]
+fn padded_pcm_uses_stored_width_and_existing_pcm_shift_parameters() {
+    let format = WaveFormatChunk::read_pcm_fmt(&mut symphonia_core::io::BufReader::new(&[]), 4, 24, 1, 16).unwrap();
+    let FormatData::Pcm(pcm) = format else { panic!("PCM format") };
+    assert_eq!((pcm.bits_per_sample, pcm.valid_bits_per_sample, pcm.sample_shift), (32, 24, 8));
+    assert_eq!(pcm.codec, CODEC_ID_PCM_S32LE);
+    assert_eq!(pcm.make_packet_info().unwrap().block_size.get(), 4);
+    let mut params = symphonia_core::codecs::audio::AudioCodecParameters::new();
+    crate::common::append_format_params(&mut params, FormatData::Pcm(pcm), 48000);
+    assert_eq!((params.bits_per_sample, params.bits_per_coded_sample), (Some(32), Some(24)));
+}
