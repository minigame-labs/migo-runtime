+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct IndexedPacket {
+    pub offset: u64,
+    pub size: u32,
+    pub track_id: u32,
+    pub pts: Timestamp,
+    pub dur: Duration,
