  local:
    # Rust's generated cdylib map marks dependency C callbacks global by name.
    # LLD gives those exact names priority over a wildcard local rule. Keep
    # these exact local overrides, checked against each actual JNI ELF by
    # android_jni_verify_exports; dependency upgrades must review any new name.
