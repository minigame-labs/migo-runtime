{
  "name": "migo-developer-docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "docs:dev": "astro dev --host 127.0.0.1 --port 8097",
    "docs:lint": "markdownlint-cli2 \"src/content/**/*.mdx\"",
    "docs:typecheck": "astro check",
    "docs:check": "npm run docs:lint && bash ../scripts/test-developer-docs-phase1-contract.sh && npm run docs:typecheck && node scripts/ensure-en-stubs.mjs --assert && node scripts/check-doc-metadata.mjs",
    "docs:build:site": "astro build",
    "docs:check:built": "node scripts/check-built-site.mjs",
    "docs:build": "npm run docs:build:site && npm run docs:check:built",
    "docs:serve": "astro preview --host 127.0.0.1 --port 8097",
    "docs:smoke": "playwright test",
    "dev": "astro dev --host 127.0.0.1 --port 8097",
    "build": "astro build",
    "docs:sync-en": "node scripts/ensure-en-stubs.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/starlight": "^0.42.10",
    "astro": "^7.4.7",
    "astro-mermaid": "^2.2.0",
    "mermaid": "^12.3.0",
    "starlight-links-validator": "^0.27.0",
    "starlight-versions": "^0.10.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "@types/node": "^26.6.6",
    "markdownlint-cli2": "0.24.0",
    "typescript": "6.0.3"
  },
  "overrides": {
    "markdownlint-cli2": {
      "markdownlint": "0.42.1"
    },
    "micromark-extension-math": {
      "katex": "0.18.11"
    }
  }
}
