# Generated by the Migo Linux Host Kit build.
include(CMakeFindDependencyMacro)

if(NOT TARGET migo::migo)
    find_dependency(migo CONFIG REQUIRED)
endif()
find_dependency(Threads REQUIRED)
if(@MIGO_LINUX_HOST_KIT_BUILD_QT6_X11@)
    find_dependency(Qt6 6.4 REQUIRED COMPONENTS Core Gui Widgets DBus Network)
    find_dependency(X11 REQUIRED)
    find_dependency(PkgConfig REQUIRED)
    pkg_check_modules(MIGO_XCB_XINPUT QUIET IMPORTED_TARGET xcb xcb-xinput)
    if(NOT MIGO_XCB_XINPUT_FOUND)
        set(${CMAKE_FIND_PACKAGE_NAME}_NOT_FOUND_MESSAGE
            "the Qt 6 X11 adapter links xcb-xinput, which pkg-config does not find")
        set(${CMAKE_FIND_PACKAGE_NAME}_FOUND FALSE)
        return()
    endif()
    pkg_check_modules(MIGO_LIBUDEV QUIET IMPORTED_TARGET libudev)
    if(NOT MIGO_LIBUDEV_FOUND)
        set(${CMAKE_FIND_PACKAGE_NAME}_NOT_FOUND_MESSAGE
            "the Qt 6 host services link libudev, which pkg-config does not find")
        set(${CMAKE_FIND_PACKAGE_NAME}_FOUND FALSE)
        return()
    endif()
    # migo::qt6-media links GStreamer: needed by an App that links it -- one
    # that asks for the component -- and by no other.
    if(@MIGO_LINUX_HOST_KIT_BUILD_QT6_MEDIA@)
        pkg_check_modules(MIGO_GSTREAMER QUIET IMPORTED_TARGET
            gstreamer-1.0 gstreamer-app-1.0 gstreamer-video-1.0)
        if(NOT MIGO_GSTREAMER_FOUND AND "qt6-media" IN_LIST ${CMAKE_FIND_PACKAGE_NAME}_FIND_COMPONENTS)
            set(${CMAKE_FIND_PACKAGE_NAME}_NOT_FOUND_MESSAGE
                "migo::qt6-media links GStreamer, which pkg-config does not find")
            set(${CMAKE_FIND_PACKAGE_NAME}_FOUND FALSE)
            return()
        endif()
    elseif("qt6-media" IN_LIST ${CMAKE_FIND_PACKAGE_NAME}_FIND_COMPONENTS)
        set(${CMAKE_FIND_PACKAGE_NAME}_NOT_FOUND_MESSAGE
            "this Host Kit was built without migo::qt6-media (MIGO_LINUX_HOST_KIT_BUILD_QT6_MEDIA)")
        set(${CMAKE_FIND_PACKAGE_NAME}_FOUND FALSE)
        return()
    endif()
endif()

include("${CMAKE_CURRENT_LIST_DIR}/migo-linux-host-kit-targets.cmake")
