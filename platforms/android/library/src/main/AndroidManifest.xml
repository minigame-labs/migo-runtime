<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- ConnectivityManager.getActiveNetwork/getNetworkCapabilities and
         registerNetworkCallback (NetworkMonitor) require this; without it
         getNetworkType and onNetworkStatusChange fail with SecurityException. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <uses-feature
        android:name="android.hardware.bluetooth"
        android:required="false" />

    <application>
        <activity
            android:name=".internal.ResultProxyActivity"
            android:exported="false"
            android:launchMode="standard"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Lends a game's file to a viewer for previewImage / previewMedia,
             read-only, one granted URI at a time. -->
        <provider
            android:name=".internal.LentFileProvider"
            android:authorities="${applicationId}.migo.lent"
            android:exported="false"
            android:grantUriPermissions="true" />

        <activity
            android:name=".MigoGameActivity"
            android:exported="false"
            android:launchMode="standard"
            android:configChanges="orientation|screenSize|keyboardHidden" />
    </application>
</manifest>
