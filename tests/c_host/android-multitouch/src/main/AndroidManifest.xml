<?xml version="1.0" encoding="utf-8"?>
<!--
  Instruments itself, not com.migo.chost: see build.gradle for why. The host is
  launched with an ordinary intent in its own process, and UiAutomation injects
  input and takes screenshots on the display both apps share.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:label="Migo C Host multitouch check" />
    <instrumentation
        android:name="com.migo.chost.multitouch.MultiTouchInstrumentation"
        android:targetPackage="com.migo.chost.multitouch" />
</manifest>
