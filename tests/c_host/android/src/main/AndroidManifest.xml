<?xml version="1.0" encoding="utf-8"?>
<!--
  No Java at all: android.app.NativeActivity loads the library named below and
  calls its ANativeActivity_onCreate. That is the point of this example - it
  demonstrates that a host embedding migo through the C ABI needs no JVM code
  of its own. android:hasCode="false" is what makes that claim checkable.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
      The network the host grants its content (files/network-policy, see main.c)
      is reachable only by an app Android lets open sockets: without this every
      socket the engine opens is refused before any policy is asked, and a UDP
      bind answers -1. A host that grants no network can leave it out.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <application
        android:label="Migo C Host"
        android:hasCode="false">
        <activity
            android:name="android.app.NativeActivity"
            android:configChanges="orientation|keyboardHidden|screenSize"
            android:exported="true"
            android:screenOrientation="user">
            <!--
              Rotatable, like the product's own MigoGameActivity, which pins no
              orientation either. Content declares the orientation it wants; a
              host that pins portrait cannot see what a rotation does to the
              surface, and rotating while backgrounded is the one lifecycle that
              hands the engine a *different* native window rather than a resized
              one. This example was locked to portrait, and both defects that
              path carries went unnoticed for exactly that reason.
            -->
            <meta-data
                android:name="android.app.lib_name"
                android:value="migo_c_host" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
